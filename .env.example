# Copy to .env (cp .env.example .env). .env is gitignored; never commit keys.
#
# Priority:  ENV  >  config/local.toml  >  config/profiles/<name>.toml  >  config/default.toml  >  code defaults
# Anything set here wins over every config file, so a profile in config/profiles is overridden by the same value here.
# Empty lines are ignored: fill in only what you want to force. The default is shown in brackets.
# Every value is validated at start (src/env.ts): a bad one stops the process with exit 78 and a list of problems.
# Any setting can also be set as STARCOACH__section__key=value, e.g. STARCOACH__risk__riskPct=0.005
# (list them with: bun run config show). Docker Compose reads this file for the trader and dashboard services.

# ---- Run mode (docker/entrypoint.sh) ----
# paper (default): paper exchange on live prices. dry: orders validated and logged, never sent. live: real orders.
STARCOACH_MODE=paper
# Live also needs this exact word, so a stray STARCOACH_MODE=live cannot place orders by accident.
STARCOACH_CONFIRM_LIVE=
# Folder with default.toml, profiles/ and local.toml [./config]. Leave unset.
# STARCOACH_CONFIG_DIR=
# Config profile from config/profiles: balanced, conservative, aggressive, backtest. Empty = defaults only.
STARCOACH_PROFILE=
# Extra arguments for `bun src/cli.ts live`, split on spaces, e.g. --symbols auto --no-metrics
STARCOACH_ARGS=
# Healthcheck: unhealthy when the daemon log is older than this many seconds (default max(180, 3 x wallex.pollMs)).
HEALTH_MAX_AGE_S=
# Written into every log line. Docker sets it at build time (GIT_SHA build arg); git is used otherwise. Leave unset.
# GIT_SHA=

# ---- Secrets (environment only, never in config files) ----
# Trade-only key, no withdrawal permission.
WALLEX_API_KEY=
AI_API_KEY=

# ---- AI supervisor (OpenAI-compatible endpoint; empty AI_BASE_URL = mock supervisor that approves) ----
AI_BASE_URL=
# [gpt-4o-mini]
AI_MODEL=
# [12000]
AI_TIMEOUT_MS=
# approve: keep the trade when the AI is unreachable. veto: skip it. [approve]
AI_FAIL_MODE=

# ---- Dashboard ----
# Shared secret (16+ characters) for the dashboard's kill-switch button. Required when the dashboard is not bound to
# localhost (Docker). Without it the button is disabled there; viewing still works.
DASHBOARD_TOKEN=
# Folder the dashboard reads logs and state from [repo root]. Leave unset unless you moved them.
# DASHBOARD_ROOT=

# ---- Run schedule ----
# ISO end time of the run, e.g. 2026-10-25T12:00:00Z. Empty = now + run.defaultHours (24).
RUN_END=
# Minutes before the end when new entries stop [45]. Nothing is sold automatically: run `bun run pullout --yes` yourself.
ENTRY_CUTOFF_MIN=

# ---- Markets, risk, fees ----
# Comma separated, e.g. PEPETMN,PUMPTMN,DOGETMN (market.symbols). `--symbols auto` picks liquid markets instead.
SYMBOLS=
# Fraction of equity lost at the stop [0.01 = 1%].
RISK_PCT=
# Fees as fractions: maker [0.0025], taker [0.003].
MAKER_FEE=
TAKER_FEE=

# Guard limits: profit-lock tiers (PnL fraction that triggers, risk after it), day halt [0.12], hard drawdown [0.3],
# no loss pause and no entry-rate limit. Defaults live in config/default.toml.
LOCK1_PNL=
LOCK1_RISK=
LOCK2_PNL=
LOCK2_RISK=
DAILY_LOSS_HALT=
HARD_DRAWDOWN=

# Wallex REST base URL [https://api.wallex.ir]
WALLEX_BASE_URL=

# Paper / backtest assumptions: spread [10 bps], slippage [10 bps], start balance [5000000 TMN].
PAPER_SPREAD_BPS=
PAPER_SLIPPAGE_BPS=
START_TMN=

# ---- Telemetry (OpenTelemetry; the Prometheus endpoint is on by default) ----
# true / 1 turns metrics off.
OTEL_SDK_DISABLED=
# Scrape endpoint [127.0.0.1:9464]. docker-compose.yml sets the host to 0.0.0.0 inside the container.
OTEL_PROMETHEUS_HOST=
OTEL_PROMETHEUS_PORT=
# Optional OTLP/HTTP push, base URL (the /v1/metrics path is added), e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Full metrics URL; wins over the base URL above.
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
