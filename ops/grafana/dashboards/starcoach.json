      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(increase(starcoach_trades_closed_total{result=\"win\"}[$__range])) / sum(increase(starcoach_trades_closed_total[$__range]))",
